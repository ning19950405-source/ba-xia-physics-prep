# 服务端默认（当页面「模型配置」未填 API Key 时回落）
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=openai:gpt-4o-mini

# 可选：使用 Anthropic / Google 且不在页面填 Key 时
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# GOOGLE_API_KEY=
# GOOGLE_BASE_URL=

# 单次请求最长等待（毫秒），默认 120000（2 分钟）；跨境/慢网可适当加大，最大 300000
# OPENAI_FETCH_TIMEOUT_MS=120000
